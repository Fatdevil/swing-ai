# Firebase Configuration
# Get these from your Firebase Console → Project Settings → General
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Server Security (set these in Railway environment variables) ──────────────
# FIREBASE_PROJECT_ID: Required in production — prevents tokens from other
# Firebase projects being accepted. Without it, audience/issuer check is skipped.
FIREBASE_PROJECT_ID=your_project_id

# ALLOWED_ORIGIN: Comma-separated allowed frontend origins (no trailing slash).
# Example: https://swing-ai.railway.app,https://your-custom-domain.com
ALLOWED_ORIGIN=https://your-railway-domain.railway.app
